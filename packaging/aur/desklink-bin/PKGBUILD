pkgname=desklink-bin
_pkgname=desklink
pkgver=1.0.0
pkgrel=1
pkgdesc='Use your Android phone and GNOME desktop together (prebuilt)'
arch=('x86_64')
url='https://github.com/derpx06/DeskLink'
license=('GPL-3.0-or-later' 'GPL-2.0-or-later')  # app; GNOME Shell extension
depends=(
  'gcc-libs'
  'glib2'
  'glibc'
  'gst-libav'
  'gst-plugin-pipewire'
  'gst-plugins-bad'
  'gst-plugins-base'
  'gst-plugins-good'
  'gstreamer'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libnice'
  'openssl'
)
optdepends=(
  'gst-plugin-gtk4: system video sink (a copy is bundled otherwise)'
  'xdg-desktop-portal-gnome: screen sharing and remote control on GNOME'
  'gst-plugin-va: hardware video decoding'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64.tar.gz")
# Replace with the real checksum (updpkgsums) once the v$pkgver release is published.
sha256sums_x86_64=('SKIP')

package() {
  cp -a "$_pkgname-$pkgver-$CARCH/usr" "$pkgdir/"
}
