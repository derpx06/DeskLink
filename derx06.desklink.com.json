{
    "id" : "derx06.desklink.com",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "desklink",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--talk-name=org.freedesktop.Flatpak",
        "--system-talk-name=org.freedesktop.login1",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.gnome.ScreenSaver",
        "--talk-name=org.mpris.MediaPlayer2.*",
        "--own-name=org.mpris.MediaPlayer2.DeskLink.*",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--own-name=org.kde.StatusNotifierItem-2-1",
        "--talk-name=org.gnome.Shell.Extensions",
        "--talk-name=org.a11y.Bus",
        "--filesystem=xdg-run/pipewire-0",
        "--filesystem=xdg-download",
        "--filesystem=~/DeskLink Bucket:create"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env" : {
            "CARGO_HOME" : "/run/build/desklink/cargo",
            "CARGO_NET_OFFLINE" : "true"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "vte",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dgtk3=false",
                "-Dgtk4=true",
                "-Dgir=false",
                "-Dvapi=false",
                "-Ddocs=false",
                "-Dglade=false",
                "-D_systemd=false"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/vte/0.84/vte-0.84.1.tar.xz",
                    "sha256" : "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8"
                }
            ]
        },
        {
            "name" : "desklink",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/derpx06/DeskLink.git",
                    "tag" : "v1.3.0"
                },
                "flatpak/cargo-sources.json"
            ]
        }
    ]
}
