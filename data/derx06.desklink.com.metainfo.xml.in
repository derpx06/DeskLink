<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>derx06.desklink.com</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later AND GPL-2.0-or-later</project_license>

  <name>DeskLink</name>
  <summary>Use your phone and computer together</summary>
  <description>
    <p>
      DeskLink connects your Android phone to your Linux desktop (GNOME, KDE Plasma, Xfce, Cinnamon, MATE, COSMIC, sway and others, on Wayland or X11). Pair once by
      scanning a code, and the two work as one: see your phone on your screen,
      control your computer from your phone, and move text, files and
      notifications between them.
    </p>
    <ul>
      <li>See your phone’s screen on the desktop, with low latency</li>
      <li>Control your computer’s mouse and keyboard from the phone, with your approval</li>
      <li>Shared terminals, with one tap on the phone to start Claude Code or Codex on your computer</li>
      <li>Phone notifications on the desktop, with replies</li>
      <li>Clipboard sync in both directions</li>
      <li>File transfer in both directions</li>
    </ul>
    <p>
      There is no account. Devices pair directly with each other, and features
      travel over encrypted, authenticated WebRTC connections. DeskLink needs
      the DeskLink Android app on the phone.
    </p>
  </description>

  <developer id="derx06.desklink">
    <name translate="no">derpx06</name>
  </developer>

  <url type="homepage">https://github.com/derpx06/DeskLink</url>
  <url type="bugtracker">https://github.com/derpx06/DeskLink/issues</url>
  <url type="vcs-browser">https://github.com/derpx06/DeskLink</url>

  <translation type="gettext">desklink</translation>
  <launchable type="desktop-id">derx06.desklink.com.desktop</launchable>
  <provides>
    <binary>desklink</binary>
  </provides>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <internet>always</internet>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#62a0ea</color>
  </branding>

  <releases>
    <release version="0.3.0" type="development" date="2026-11-17">
      <description translate="no">
        <p>The first public release, a beta: a steadier connection, notes, and a calmer Home.</p>
        <ul>
          <li>The connection says “Checking connection…” when the phone goes quiet and recovers or gives up within seconds; a click on a phone that does not answer says so at once</li>
          <li>The phone tells the computer when Wi-Fi or the app is about to go away</li>
          <li>Pairing from the phone now brings the connection up by itself</li>
          <li>A Notes card on Home, two balanced columns on a big window, and a narrow sidebar rail</li>
          <li>Files, Notes, Terminals, Contacts and Settings use a big window; notifications are grouped by app</li>
          <li>Safer pairing and sessions: unpaired links are limited per network and the listener serves local sources only</li>
          <li>Removed: browsing the phone’s files, the presentation remote, Bluetooth, run commands, the drawing pad, the webcam and system volume</li>
          <li>LAN only: the away-from-home relay is built but switched off</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
