[Desktop Entry]
Name=DeskLink
Comment=Use your phone and computer together
Exec=desklink %U
Icon=derx06.desklink.com
Terminal=false
Type=Application
Categories=Network;RemoteAccess;FileTransfer;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons. The list MUST also end with a semicolon.
Keywords=phone;android;remote;terminal;clipboard;notifications;file;transfer;screen;
StartupNotify=true
DBusActivatable=true
# `tel:` links: DeskLink asks, then the phone calls.
MimeType=x-scheme-handler/tel;
X-GNOME-UsesNotifications=true
